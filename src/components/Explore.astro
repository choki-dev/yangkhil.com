---
import { Image } from 'astro:assets';
import Link from './Link.astro';
import { site } from '../data/site';
const { explore: e } = site;
---
<section class="explore" id="explore-trongsa" data-header-theme="light">
  <span class="label" data-fade>{e.label}</span>
  <div class="explore__head">
    <h2 class="title-l" data-split>{e.title}</h2>
    <div class="explore__foot">
      <p class="text" data-fade>{e.text}</p>
      <Link href={e.link.href} label={e.link.label} />
    </div>
  </div>
  <div class="swiper" data-slider data-autoplay>
    <div class="swiper-wrapper">
      {e.posts.map((p) => (
        <article class="swiper-slide">
          <a class="story" href={p.href}>
            <div class="frame">
              <Image src={p.image} alt={p.alt} widths={[700, 1200, 1800]} sizes="(max-width: 767px) 90vw, 70vw" loading="lazy" />
            </div>
            <div class="story__copy">
              <span class="label">{p.tag}</span>
              <h3 class="title-l">{p.title}</h3>
              <p>{p.text}</p>
              <span class="link">Read more<span class="arrow" aria-hidden="true"><svg viewBox="0 0 8 8" fill="none"><path d="M1 4h6M4.5 1.5 7 4 4.5 6.5" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
  <div class="pill" role="group" aria-label="Slideshow controls">
    <button type="button" data-prev aria-label="Previous story">&larr;</button>
    <span class="pill__count label" data-count aria-live="polite"></span>
    <div class="pill__bar" aria-hidden="true"><i data-progress></i></div>
    <button type="button" data-next aria-label="Next story">&rarr;</button>
  </div>
</section>
