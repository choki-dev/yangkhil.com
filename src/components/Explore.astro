---
import { Image } from 'astro:assets';
import Link from './Link.astro';
import { site, explorePage } from '../data/site';
const { explore: e } = site;
// the home page shows one place; the full list is on the Explore Trongsa page
const p = e.posts[0];
---
<section class="explore" id="explore-trongsa" data-header-theme="light">
  <span class="label" data-fade>{e.label}</span>
  <div class="explore__head">
    <h2 class="title-l" data-split>{e.title}</h2>
    <div class="explore__foot">
      <p class="text" data-fade>{e.text}</p>
      <Link href={e.link.href} label={e.link.label} />
    </div>
  </div>
  <div class="explore__body">
    <a class="story" href={`${explorePage}#${p.id}`} aria-label={`${p.title}: read more on the Explore Trongsa page`}>
      <div class="frame">
        <Image src={p.image} alt={p.alt} widths={[700, 1200, 1800]} quality={70} sizes="(max-width: 767px) 90vw, 70vw" loading="lazy" />
      </div>
    </a>
    <div class="explore__place">
      <span class="label" data-fade>{p.tag}</span>
      <h3 class="title-m" data-split>{p.title}</h3>
      {(p.details ?? [p.text]).map((t) => <p class="text" data-fade>{t}</p>)}
      <Link href={`${explorePage}#${p.id}`} label="Read more" />
    </div>
  </div>
</section>
