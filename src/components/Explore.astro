---
import { Image } from 'astro:assets';
import { site } from '../data/site';
const { explore: e } = site;
---
<!-- home page Explore Trongsa: title on the left, photo card on the right; the button under the text opens every attraction -->
<section class="explore-cards explore-split" id="explore-trongsa" data-header-theme="light">
  <div class="head head--left">
    <span class="head__script" aria-hidden="true">Discover</span>
    <h2 class="head__title" data-split>{e.label}</h2>
  </div>
  <div class="place-card place-card--single" data-fade>
    <div class="place-card__media">
      <div class="frame">
        <Image src={e.hero} alt={e.heroAlt} widths={[700, 1100, 1500]} quality={88} sizes="(max-width: 767px) 100vw, 640px" loading="lazy" />
      </div>
    </div>
    <div class="place-card__body">
      <p>{e.text}</p>
      <a class="btn place-card__btn" href={e.link.href}>See all attractions</a>
    </div>
  </div>
</section>
