---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { label: string; title: string; image: ImageMetadata; alt: string }
const { label, title, image, alt } = Astro.props;
---
<section class="page-hero on-dark" id="top" data-header-theme="dark">
  <div class="frame fill shade" data-parallax>
    <Image src={image} alt={alt} widths={[1280, 1920, 2560, 3200]} quality={88} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="page-hero__copy">
    <span class="label">{label}</span>
    <h1 data-split>{title}</h1>
  </div>
</section>
