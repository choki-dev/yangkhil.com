---
import { Image, getImage } from 'astro:assets';
import { site } from '../data/site';
const { hero } = site;
const widths = [1280, 1920, 2560, 3200];
const quality = 88;
// slides after the first are fetched by main.ts once the page has loaded,
// so they don't compete with the first slide for bandwidth
const later = await Promise.all(hero.slides.slice(1).map((s) => getImage({ src: s.image, widths, quality, format: 'webp' })));
---
<section class="hero full on-dark" id="top" data-header-theme="dark">
  <div class="hero__slides shade">
    {hero.slides.map((s, i) => (
      <div class="hero__slide" data-hero-slide style={i === 0 ? undefined : 'opacity:0'}>
        {i === 0 ? (
          <Image src={s.image} alt={s.alt} widths={widths} quality={quality} sizes="100vw" loading="eager" fetchpriority="high" />
        ) : (
          <img data-src={later[i - 1].src} data-srcset={later[i - 1].srcSet.attribute} sizes="100vw" alt={s.alt} width={later[i - 1].attributes.width} height={later[i - 1].attributes.height} decoding="async" />
        )}
      </div>
    ))}
  </div>
  <!-- centred copy: label, script headline, subheading and two buttons -->
  <div class="hero__copy">
    <span class="label" data-fade>{hero.label}</span>
    <h1 data-split data-hero-title>
      {hero.titleLines.map((l) => <span class="hero__line">{l}</span>)}
    </h1>
    <p class="hero__text" data-fade>{hero.text}</p>
    <div class="hero__ctas" data-fade>
      <a class="btn" href={hero.link.href}>{hero.link.label}</a>
      <a class="btn btn--ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
    </div>
  </div>
  {hero.slides.length > 1 && (
    <>
      <button class="hero__arrow hero__arrow--prev" type="button" aria-label="Previous photo" data-hero-prev><svg viewBox="0 0 14 26" aria-hidden="true"><path d="M13 1 1 13l12 12" /></svg></button>
      <button class="hero__arrow hero__arrow--next" type="button" aria-label="Next photo" data-hero-next><svg viewBox="0 0 14 26" aria-hidden="true"><path d="m1 1 12 12L1 25" /></svg></button>
    </>
  )}
</section>
