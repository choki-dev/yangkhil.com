---
import { Image } from 'astro:assets';
import Link from './Link.astro';
import { site } from '../data/site';
const { about } = site;
---
<section class="about" id="about" data-header-theme="light">
  <span class="label" data-fade>{about.label}</span>
  <div class="frame" data-parallax>
    <Image src={about.image} alt={about.alt} style={`object-position: ${about.position}`} widths={[900, 1400, 2000, 2600]} quality={88} sizes="(max-width: 767px) 160vw, (max-width: 1100px) 75vw, 60vw" loading="lazy" />
  </div>
  <div class="about__text">
    <h2 class="title-l" data-split>{about.title}</h2>
    <div class="about__foot">
      <p class="text" data-fade>{about.text}</p>
      <Link href={about.link.href} label={about.link.label} />
    </div>
  </div>
</section>
