---
import { Image } from 'astro:assets';
import Link from './Link.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../data/site';
const { about } = site;
---
<!-- welcome: centred title and text, then a row of three photos -->
<section class="about" id="about" data-header-theme="light">
  <SectionHead script={about.script} title={about.title} />
  <p class="about__text" data-fade>{about.text}</p>
  <Link href={about.link.href} label={about.link.label} />
  <ul class="about__photos">
    {about.gallery.map((g) => (
      <li class="frame" data-fade>
        <Image src={g.image} alt={g.alt} widths={[500, 800, 1200]} quality={88} sizes="(max-width: 767px) 100vw, 30vw" loading="lazy" />
      </li>
    ))}
  </ul>
</section>
