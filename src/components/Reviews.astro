---
import Link from './Link.astro';
import { site } from '../data/site';
import { getReviews } from '../data/reviews';
const { reviews: r } = site;
// live Google reviews when an API key is set, otherwise the ones in site.ts
const { items, rating, total, googleUrl } = await getReviews();
const links = r.links.map((l) => (googleUrl && l.label.includes('Google') ? { ...l, href: googleUrl } : l));
---
<section class="reviews" id="reviews" data-header-theme="light">
  <span class="label" data-fade>{r.label}</span>
  <div class="reviews__head">
    <h2 class="title-l" data-split>{r.title}</h2>
    {rating && total && (
      <p class="reviews__score" data-fade>
        <span class="review__stars" aria-hidden="true">&#9733;</span>
        <b>{rating.toFixed(1)}</b> from {total.toLocaleString('en-GB')} Google reviews
      </p>
    )}
  </div>
  {r.trustindex.length ? (
    r.trustindex.map((id) => (
      <div class="reviews__widget">
        <script is:inline defer async src={`https://cdn.trustindex.io/loader.js?${id}`}></script>
      </div>
    ))
  ) : (
  <ul class="reviews__grid">
    {items.map((item) => (
      <li class="review" data-fade>
        <span class="review__stars" role="img" aria-label={`${item.rating} out of 5 stars`}>
          {Array.from({ length: 5 }, (_, i) => <span aria-hidden="true" class:list={{ 'is-off': i >= item.rating }}>&#9733;</span>)}
        </span>
        <blockquote class="review__quote">{item.quote}</blockquote>
        <div class="review__meta">
          <span>{item.name}</span>
          <span class="label">
            {item.date} &middot; {item.href ? <a href={item.href} target="_blank" rel="noopener">{item.source}</a> : item.source}
          </span>
        </div>
      </li>
    ))}
  </ul>
  )}
  {r.tripadvisorId && (
    <div class="reviews__widget reviews__widget--tripadvisor">
      <div id="TA_selfserveprop101" class="TA_selfserveprop">
        <ul id="ta-links" class="TA_links">
          <li><a target="_blank" rel="noopener" href="https://www.tripadvisor.com/">Tripadvisor</a></li>
        </ul>
      </div>
      <script is:inline async src={`https://www.jscache.com/wejs?wtype=selfserveprop&uniq=101&locationId=${r.tripadvisorId}&lang=en_US&rating=true&nreviews=5&writereviewlink=true&popIdx=true&iswide=true&border=false&display_version=2`}></script>
    </div>
  )}
  <div class="reviews__links">
    {links.map((l) => <Link href={l.href} label={l.label} />)}
  </div>
</section>
