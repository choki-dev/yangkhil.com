---
// Review rows (Trustindex-style, like callofthedragonbhutan.com): an overall score on the left
// ("EXCELLENT", rating icons, review count, logo) and a slider of review cards on the right.
// Tripadvisor first, Google below. The reviews are saved in src/data/reviews.ts (5-star only).
import SectionHead from './SectionHead.astro';
import {
  reviews, reviewUrl, tripadvisorUrl, tripadvisorSummary,
  googleReviews, googleUrl, googleSummary,
} from '../data/reviews';
import googleIcon from '../assets/reviews/google-icon.svg';
import googleLogo from '../assets/reviews/google-logo.svg';
import tripadvisorLogo from '../assets/reviews/tripadvisor-logo.svg';
import tripadvisorIcon from '../assets/reviews/tripadvisor-icon.svg';

const avatars = import.meta.glob<{ default: ImageMetadata }>('../assets/reviews/avatars/*', { eager: true });
const avatar = (file?: string) => (file ? avatars[`../assets/reviews/avatars/${file}`]?.default.src : undefined);

/** "2026-10" or "2026-10-24" -> Unix seconds */
const toTime = (date: string) => {
  const [y, m, d = 1] = date.split('-').map(Number);
  return Date.UTC(y, m - 1, d) / 1000;
};

type Card = { name: string; time: number; rating: number; text: string; href: string; photo?: string };
type Source = { key: 'tripadvisor' | 'google'; name: string; href: string; rating: number; total: number; cards: Card[] };

const sources = ([
  {
    key: 'tripadvisor',
    name: 'Tripadvisor',
    href: tripadvisorUrl,
    ...tripadvisorSummary,
    // Tripadvisor reviews have a title: shown as the first line, as Tripadvisor does
    cards: reviews.map((r) => ({ name: r.name, time: toTime(r.date), rating: r.rating, text: `${r.title}<br>${r.text}`, href: reviewUrl(r.id), photo: avatar(r.avatar) })),
  },
  {
    key: 'google',
    name: 'Google',
    href: googleUrl,
    ...googleSummary,
    cards: googleReviews.map((r) => ({ name: r.name, time: toTime(r.date), rating: r.rating, text: r.text, href: googleUrl, photo: avatar(r.avatar) })),
  },
] as Source[]).filter((s) => s.cards.length > 0);

/** the word above the score, worked out from the rating so it always matches it */
const verdict = (rating: number) => (rating >= 4.5 ? 'Excellent' : rating >= 4 ? 'Very good' : rating >= 3 ? 'Good' : 'Average');
/** how much of icon i (0–4) is filled for a rating, 0–1 */
const fill = (rating: number, i: number) => Math.max(0, Math.min(1, rating - i));

/** "7 months ago" style label (refreshed in the browser so it never goes stale) */
const relativeTime = (time: number, now = Date.now() / 1000) => {
  const days = Math.floor((now - time) / 86400);
  const label = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'} ago`;
  if (days < 1) return 'today';
  if (days < 7) return label(days, 'day');
  if (days < 30) return label(Math.round(days / 7), 'week');
  if (days < 365) return label(Math.round(days / 30), 'month');
  return label(Math.floor(days / 365), 'year');
};
const monthYear = (time: number) => new Date(time * 1000).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', timeZone: 'UTC' });

// letter avatars, colour picked from the name so each guest keeps the same one
const colours = ['#1a73e8', '#d93025', '#188038', '#e37400', '#9334e6', '#c5221f', '#007b83', '#5f6368'];
const colour = (name: string) => colours[[...name].reduce((n, c) => n + c.charCodeAt(0), 0) % colours.length];

const star = 'M12 1.8l3.1 6.6 7.1.8-5.3 4.9 1.4 7.1L12 17.6l-6.3 3.6 1.4-7.1L1.8 9.2l7.1-.8z';
// scalloped "verified" badge: a 12-point rosette
const badge = Array.from({ length: 24 }, (_, i) => {
  const a = (Math.PI * i) / 12, r = i % 2 ? 10.2 : 12;
  return `${(12 + r * Math.sin(a)).toFixed(2)},${(12 - r * Math.cos(a)).toFixed(2)}`;
}).join(' ');
---
<section class="reviews" id="reviews" data-header-theme="light">
  <SectionHead script="Guest" title="Reviews" />

  {sources.map((s) => (
    <div class:list={['reviews__row', `reviews__row--${s.key}`]}>
      <!-- overall score -->
      <a class="reviews__score" href={s.href} target="_blank" rel="noopener" aria-label={`${verdict(s.rating)}: rated ${s.rating} out of 5, based on ${s.total} reviews on ${s.name}`}>
        <span class="reviews__verdict">{verdict(s.rating)}</span>
        <span class="reviews__icons reviews__icons--lg" aria-hidden="true">
          {Array.from({ length: 5 }, (_, i) => (
            <span class="rate" style={`--fill:${fill(s.key === 'tripadvisor' ? Math.round(s.rating * 2) / 2 : s.rating, i)}`}>
              {s.key === 'google'
                ? <><svg class="rate__off" viewBox="0 0 24 24"><path d={star} /></svg><svg class="rate__on" viewBox="0 0 24 24"><path d={star} /></svg></>
                : <><svg class="rate__off" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5" /></svg><svg class="rate__on" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5" /><circle class="rate__dot" cx="12" cy="12" r="7" /></svg></>}
            </span>
          ))}
        </span>
        <span class="reviews__based">Based on <strong>{s.total} reviews</strong></span>
        {s.key === 'google'
          ? <img class="reviews__logo reviews__logo--google" src={googleLogo.src} alt="Google" width="98" height="33" loading="lazy" />
          : <img class="reviews__logo reviews__logo--tripadvisor" src={tripadvisorLogo.src} alt="Tripadvisor" width="122" height="26" loading="lazy" />}
      </a>

      <!-- review cards -->
      <div class="reviews__slider" data-reviews aria-roledescription="carousel" aria-label={`${s.name} reviews`}>
        <div class="swiper">
          <div class="swiper-wrapper">
            {s.cards.map((r) => (
              <article class="swiper-slide review">
                <header class="review__head">
                  {r.photo
                    ? <img class="review__avatar" src={r.photo} alt="" width="40" height="40" loading="lazy" />
                    : <span class="review__avatar" style={`background:${colour(r.name)}`} aria-hidden="true">{[...r.name.trim()][0]}</span>}
                  <div class="review__who">
                    <h3 class="review__name">{r.name}</h3>
                    <time class="review__date" datetime={new Date(r.time * 1000).toISOString().slice(0, 10)} title={monthYear(r.time)} data-time={r.time}>{relativeTime(r.time)}</time>
                  </div>
                  <a class="review__source" href={r.href} target="_blank" rel="noopener" aria-label={`Read ${r.name}’s review on ${s.name}`} title={`Posted on ${s.name}`}>
                    {s.key === 'google'
                      ? <img src={googleIcon.src} alt="" width="20" height="20" loading="lazy" />
                      : <img src={tripadvisorIcon.src} alt="" width="20" height="20" loading="lazy" />}
                  </a>
                </header>
                <p class="review__rating" role="img" aria-label={`Rated ${r.rating} out of 5`}>
                  <span class="reviews__icons" aria-hidden="true">
                    {Array.from({ length: 5 }, (_, i) => (
                      <span class="rate" style={`--fill:${fill(r.rating, i)}`}>
                        {s.key === 'google'
                          ? <><svg class="rate__off" viewBox="0 0 24 24"><path d={star} /></svg><svg class="rate__on" viewBox="0 0 24 24"><path d={star} /></svg></>
                          : <><svg class="rate__off" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5" /></svg><svg class="rate__on" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5" /><circle class="rate__dot" cx="12" cy="12" r="7" /></svg></>}
                      </span>
                    ))}
                  </span>
                  <svg class="review__verified" viewBox="0 0 24 24" aria-hidden="true"><polygon points={badge} /><path d="m7.6 12.2 3 3 5.8-6" /></svg>
                </p>
                <div class="review__text" set:html={r.text} data-text />
                <button class="review__more" type="button" aria-expanded="false" data-more>Read more</button>
              </article>
            ))}
          </div>
        </div>
        <button class="reviews__arrow reviews__arrow--prev" type="button" aria-label={`Previous ${s.name} reviews`} data-reviews-prev><svg viewBox="0 0 10 16" aria-hidden="true"><path d="M7.5 2 2 8l5.5 6" /></svg></button>
        <button class="reviews__arrow reviews__arrow--next" type="button" aria-label={`Next ${s.name} reviews`} data-reviews-next><svg viewBox="0 0 10 16" aria-hidden="true"><path d="m2.5 2 5.5 6-5.5 6" /></svg></button>
      </div>
    </div>
  ))}
</section>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Navigation } from 'swiper/modules';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const now = Date.now() / 1000;
  const label = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'} ago`;

  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((slider) => {
    // keep "x months ago" current between rebuilds
    slider.querySelectorAll<HTMLElement>('time[data-time]').forEach((el) => {
      const days = Math.floor((now - Number(el.dataset.time)) / 86400);
      el.textContent =
        days < 1 ? 'today'
        : days < 7 ? label(days, 'day')
        : days < 30 ? label(Math.round(days / 7), 'week')
        : days < 365 ? label(Math.round(days / 30), 'month')
        : label(Math.floor(days / 365), 'year');
    });

    // "Read more" only where the text is longer than four lines
    // (checked again once fonts have loaded, and when the window is resized)
    const cards = Array.from(slider.querySelectorAll<HTMLElement>('.review')).map((card) => ({
      text: card.querySelector<HTMLElement>('[data-text]')!,
      more: card.querySelector<HTMLButtonElement>('[data-more]')!,
    }));
    const fit = () => cards.forEach(({ text, more }) => {
      if (!text.classList.contains('is-open')) more.hidden = text.scrollHeight <= text.clientHeight + 1;
    });
    fit();
    document.fonts?.ready.then(fit);
    window.addEventListener('resize', fit);
    cards.forEach(({ text, more }) => {
      more.addEventListener('click', () => {
        const open = text.classList.toggle('is-open');
        more.textContent = open ? 'Hide' : 'Read more';
        more.setAttribute('aria-expanded', String(open));
      });
    });

    // the arrow at an end is hidden (Swiper marks it disabled); autoplay goes back to the start after the last card
    new Swiper(slider.querySelector<HTMLElement>('.swiper')!, {
      modules: [Autoplay, Navigation],
      slidesPerView: 1,
      spaceBetween: 16,
      speed: 600,
      breakpoints: { 600: { slidesPerView: 2 }, 1100: { slidesPerView: 3 } },
      autoplay: reduced ? false : { delay: 6000, pauseOnMouseEnter: true, disableOnInteraction: false },
      navigation: { prevEl: slider.querySelector<HTMLElement>('[data-reviews-prev]'), nextEl: slider.querySelector<HTMLElement>('[data-reviews-next]') },
    });
  });
</script>
