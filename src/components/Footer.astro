---
import { site, homeLink } from '../data/site';
const { footer } = site;
const icons: Record<string, string> = {
  facebook: 'M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9h3l.5-4h-3.5V8.8c0-.5.3-.8.5-.8Z',
  instagram: 'M12 7.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Zm0 7.4a2.9 2.9 0 1 1 0-5.8 2.9 2.9 0 0 1 0 5.8ZM16.8 6.2a1 1 0 1 0 0 2 1 1 0 0 0 0-2ZM12 3.5c-2.3 0-2.6 0-3.5.1-3 .1-4.7 1.8-4.8 4.8-.1.9-.1 1.2-.1 3.6s0 2.7.1 3.6c.1 3 1.8 4.7 4.8 4.8.9.1 1.2.1 3.5.1s2.7 0 3.6-.1c3-.1 4.7-1.8 4.8-4.8.1-.9.1-1.2.1-3.6s0-2.7-.1-3.6c-.1-3-1.8-4.7-4.8-4.8-.9-.1-1.2-.1-3.6-.1Zm0 1.5c2.3 0 2.6 0 3.5.1 2.1.1 3.2 1.1 3.3 3.3.1.9.1 1.2.1 3.5s0 2.6-.1 3.5c-.1 2.2-1.1 3.2-3.3 3.3-.9.1-1.2.1-3.5.1s-2.6 0-3.5-.1c-2.2-.1-3.2-1.1-3.3-3.3-.1-.9-.1-1.2-.1-3.5s0-2.6.1-3.5c.1-2.2 1.1-3.2 3.3-3.3.9-.1 1.2-.1 3.5-.1Z',
  tiktok: 'M16.6 3h-3.2v12.4a2.7 2.7 0 1 1-2.7-2.7c.3 0 .6 0 .8.1V9.5a6 6 0 1 0 5.1 5.9V9.1a7.6 7.6 0 0 0 4.4 1.4V7.3c-2.4 0-4.4-1.9-4.4-4.3Z',
};
---
<footer class="footer" data-header-theme="light">
  <div class="footer__cols">
    <div>
      <span class="label">Navigation</span>
      <nav class="footer__nav" aria-label="Footer">
        {site.nav.map((l) => <a href={homeLink(l.href, Astro.url.pathname)}>{l.label}</a>)}
      </nav>
    </div>
    <div>
      <span class="label">Contact</span>
      <address class="footer__nav footer__contact">
        {site.contact.details.map((d) => (d.href ? <a href={d.href}>{d.text}</a> : <span>{d.text}</span>))}
      </address>
    </div>
    <div>
      <span class="label">Quick links</span>
      <nav class="footer__nav" aria-label="Quick links">
        {footer.quickLinks.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
      </nav>
    </div>
    <div>
      <span class="label">Follow us</span>
      <nav class="footer__nav" aria-label="Social">
        {footer.social.map((l) => (
          <a class="footer__social" href={l.href} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[l.icon]} /></svg>
            {l.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
  <hr />
  <div class="footer__bar label"><span>Yangkhil Resort &copy; 2026</span><span>Website designed and developed by <a class="footer__credit" href="https://abit.bt/" target="_blank" rel="noopener">aBit Private Limited</a></span></div>
</footer>
