---
import { Image } from 'astro:assets';
import Link from './Link.astro';
import { site } from '../data/site';
---
<section class="cards" id="amenities" data-header-theme="light">
  <div class="swiper" data-slider>
    <div class="swiper-wrapper">
      {site.amenities.map((a) => (
        <article class="swiper-slide">
          <div class="card">
            <div class="frame">
              <Image src={a.image} alt={a.alt} widths={[400, 700, 1000]} quality={70} sizes="(max-width: 767px) 85vw, 33vw" loading="lazy" />
            </div>
            <div class="card__top"><h3 class="title-m">{a.title}</h3></div>
            <div class="card__bottom">
              <p>{a.text}</p>
              <Link href="#contact" label="Explore more" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
  <div class="pill" role="group" aria-label="Slider controls">
    <button type="button" data-prev aria-label="Previous amenity">&larr;</button>
    <div class="pill__bar" aria-hidden="true"><i data-progress></i></div>
    <button type="button" data-next aria-label="Next amenity">&rarr;</button>
  </div>
</section>
