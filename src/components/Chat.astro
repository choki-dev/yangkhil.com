---
import { site } from '../data/site';
const icons: Record<string, string> = {
  whatsapp: 'M12 2.5a9.4 9.4 0 0 0-8.1 14.2L2.5 21.5l4.9-1.3A9.4 9.4 0 1 0 12 2.5Zm0 17.2c-1.4 0-2.8-.4-4-1.1l-.3-.2-2.9.8.8-2.8-.2-.3a7.8 7.8 0 1 1 6.6 3.6Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3c-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.3Z',
  phone: 'M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z',
  email: 'M4 5h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H4a2 2 0 0 1-2-2V7c0-1.1.9-2 2-2Zm0 2v.5l8 5 8-5V7H4Zm16 2.9-7.5 4.7c-.3.2-.7.2-1 0L4 9.9V17h16V9.9Z',
};
---
<div class="chaty" id="chaty">
  <ul class="chaty__list" id="chaty-list">
    {site.chat.map((c) => (
      <li>
        <a class={`chaty__item chaty__item--${c.icon}`} href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener" tabindex="-1">
          <span class="chaty__label">{c.label}</span>
          <span class="chaty__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[c.icon]} /></svg></span>
        </a>
      </li>
    ))}
  </ul>
  <button class="chaty__toggle" id="chaty-toggle" type="button" aria-expanded="false" aria-controls="chaty-list" aria-label="Contact us">
    <svg class="chaty__open" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M4 4h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H8l-4 4V6c0-1.1.9-2 2-2Zm3 6.5a1.5 1.5 0 1 0 0 .01Zm5 0a1.5 1.5 0 1 0 0 .01Zm5 0a1.5 1.5 0 1 0 0 .01Z" /></svg>
    <svg class="chaty__close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
  </button>
</div>
