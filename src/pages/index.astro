---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Retreat from '../components/Retreat.astro';
import CardSlider from '../components/CardSlider.astro';
import About from '../components/About.astro';
import Reviews from '../components/Reviews.astro';
import Explore from '../components/Explore.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Chat from '../components/Chat.astro';
---
<Layout title="Yangkhil Resort | Mountain retreat in Trongsa, Bhutan" description="Yangkhil Resort is a mountain retreat in Trongsa, Bhutan, with timber rooms, quiet gardens and warm Bhutanese hospitality.">
  <Header />
  <main>
    <Hero />
    <About />
    <Reviews />
    <Retreat />
    <CardSlider />
    <Explore />
    <Contact />
  </main>
  <Footer />
  <Chat />
</Layout>
