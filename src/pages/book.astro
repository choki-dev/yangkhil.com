---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chat from '../components/Chat.astro';
import { site } from '../data/site';
const { booking: b } = site;
const icons: Record<string, string> = {
  whatsapp: 'M12 2.5a9.4 9.4 0 0 0-8.1 14.2L2.5 21.5l4.9-1.3A9.4 9.4 0 1 0 12 2.5Zm0 17.2c-1.4 0-2.8-.4-4-1.1l-.3-.2-2.9.8.8-2.8-.2-.3a7.8 7.8 0 1 1 6.6 3.6Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3c-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.3Z',
  phone: 'M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z',
  email: 'M4 5h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H4a2 2 0 0 1-2-2V7c0-1.1.9-2 2-2Zm0 2v.5l8 5 8-5V7H4Zm16 2.9-7.5 4.7c-.3.2-.7.2-1 0L4 9.9V17h16V9.9Z',
};
// what each contact line shows under its label
const reach: Record<string, string> = {
  whatsapp: '+975 17111588',
  phone: '+975-3-521417/18',
  email: 'yangkhilreservation@gmail.com',
};
---
<Layout title="Book Your Stay | Yangkhil Resort" description="Send a booking enquiry to Yangkhil Resort, Trongsa: choose your dates, number of guests and room type, and reach our reservations team on WhatsApp or by email.">
  <Header />
  <main>
    <section class="stay">
      <aside class="stay__media on-dark">
        <div class="frame fill shade stay__bg">
          <Image src={b.image} alt="" widths={[1280, 1920, 2560, 3200]} quality={88} sizes="(max-width: 1100px) 100vw, 42vw" loading="eager" fetchpriority="high" />
        </div>
        <div class="stay__copy">
          <span class="label">{b.label}</span>
          <h1 data-split>{b.title}</h1>
          <p class="text" data-fade>{b.text}</p>
          <ul class="stay__contact" data-fade>
            {site.chat.map((c) => (
              <li>
                <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                  <span class="stay__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[c.icon]} /></svg></span>
                  <span><small>{c.label}</small>{reach[c.icon]}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <form class="planner" id="book-form" data-whatsapp={b.whatsapp} data-email={b.email} data-key={b.web3formsKey} novalidate>
        <h2 class="title-m">Booking enquiry</h2>
        <div class="field-row">
          <div class="field">
            <label for="bk-in">Check-in</label>
            <input id="bk-in" name="checkin" type="date" required />
          </div>
          <div class="field">
            <label for="bk-out">Check-out</label>
            <input id="bk-out" name="checkout" type="date" required />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="bk-guests">Guests</label>
            <input id="bk-guests" name="guests" type="number" min="1" max="60" value="2" inputmode="numeric" />
          </div>
          <div class="field">
            <label for="bk-rooms">Rooms</label>
            <input id="bk-rooms" name="rooms" type="number" min="1" max="21" value="1" inputmode="numeric" />
          </div>
        </div>
        <div class="field">
          <label for="bk-room">Room type</label>
          <select id="bk-room" name="room">
            <option value="">No preference</option>
            {site.roomsSection.rooms.map((r) => <option value={r.name}>{r.name} ({r.guests}, {r.bed.toLowerCase()})</option>)}
          </select>
        </div>
        <div class="field">
          <label for="bk-name">Your name</label>
          <input id="bk-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="bk-email">Email</label>
            <input id="bk-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          </div>
          <div class="field">
            <label for="bk-phone">Phone <span>(optional)</span></label>
            <input id="bk-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
          </div>
        </div>
        <!-- spam trap: hidden from people, Web3Forms drops any submission that ticks it -->
        <input type="checkbox" name="botcheck" class="book__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="field">
          <label for="bk-msg">Message <span>(optional)</span></label>
          <textarea id="bk-msg" name="message" rows="3"></textarea>
        </div>
        <p class="planner__summary" id="book-summary" aria-live="polite"></p>
        <p class="book__error" id="book-error" role="alert" hidden></p>
        <p class="book__success" id="book-success" role="status" hidden></p>
        <div class="planner__actions">
          <button type="submit" class="planner__submit" value="send">Send enquiry</button>
          <button type="submit" class="planner__submit planner__submit--alt" value="whatsapp">Send on WhatsApp</button>
        </div>
        <p class="book__fine">Send enquiry emails your details straight to our reservations team. WhatsApp opens a chat with your enquiry filled in.</p>
      </form>
    </section>
  </main>
  <Footer />
  <Chat />
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#book-form');
  if (form) {
    const error = document.querySelector<HTMLElement>('#book-error')!;
    const success = document.querySelector<HTMLElement>('#book-success')!;
    const summary = document.querySelector<HTMLElement>('#book-summary')!;
    const field = <T extends HTMLElement>(name: string) => form.elements.namedItem(name) as unknown as T;
    const checkin = field<HTMLInputElement>('checkin');
    const checkout = field<HTMLInputElement>('checkout');
    const iso = (d: Date) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    const pretty = (v: string) => new Date(`${v}T00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
    const get = (k: string) => String(new FormData(form).get(k) ?? '').trim();

    // live summary line above the buttons
    const update = () => {
      const parts: string[] = [];
      if (checkin.value && checkout.value && checkout.value > checkin.value) {
        const nights = Math.round((+new Date(`${checkout.value}T00:00`) - +new Date(`${checkin.value}T00:00`)) / 86400000);
        parts.push(plural(nights, 'night'));
      }
      parts.push(plural(Number(get('guests')) || 1, 'guest'), plural(Number(get('rooms')) || 1, 'room'));
      if (get('room')) parts.push(get('room'));
      summary.textContent = parts.join(' · ');
    };

    // no past dates; check-out at least the night after check-in
    checkin.min = iso(new Date());
    checkout.min = checkin.min;
    checkin.addEventListener('change', () => {
      if (!checkin.value) return;
      const next = new Date(`${checkin.value}T00:00`);
      next.setDate(next.getDate() + 1);
      checkout.min = iso(next);
      if (checkout.value && checkout.value < checkout.min) checkout.value = '';
    });

    // ?room=Deluxe%20Double from the Rooms page, ?interest=Spa from the Amenities page
    const params = new URLSearchParams(location.search);
    const room = params.get('room');
    const select = field<HTMLSelectElement>('room');
    if (room && Array.from(select.options).some((o) => o.value === room)) select.value = room;
    const interest = params.get('interest');
    if (interest) field<HTMLTextAreaElement>('message').value = `I'm also interested in: ${interest}`;

    form.addEventListener('input', update);
    form.addEventListener('change', update);
    update();

    form.addEventListener('submit', async (e: SubmitEvent) => {
      e.preventDefault();
      const button = e.submitter as HTMLButtonElement | null;
      const viaWhatsapp = button?.value === 'whatsapp';
      success.hidden = true;
      let problem = '';
      if (!get('checkin') || !get('checkout')) problem = 'Please choose your check-in and check-out dates.';
      else if (get('checkout') <= get('checkin')) problem = 'Check-out must be after check-in.';
      else if (Number(get('guests')) < 1) problem = 'Please enter the number of guests.';
      else if (!get('name')) problem = 'Please enter your name.';
      // the team needs an email address to reply to an enquiry sent from the site
      else if (!viaWhatsapp && !get('email')) problem = 'Please enter your email address so we can reply.';
      else if (!viaWhatsapp && !field<HTMLInputElement>('email').checkValidity()) problem = 'Please enter a valid email address so we can reply.';
      error.hidden = !problem;
      error.textContent = problem;
      if (problem) return;

      const lines = [
        'Hello Yangkhil Resort, I would like to enquire about a booking.',
        '',
        `Name: ${get('name')}`,
        `Check-in: ${pretty(get('checkin'))}`,
        `Check-out: ${pretty(get('checkout'))}`,
        `Guests: ${get('guests')}`,
        `Rooms: ${get('rooms') || '1'}`,
        `Room type: ${get('room') || 'No preference'}`,
      ];
      if (get('email')) lines.push(`Email: ${get('email')}`);
      if (get('phone')) lines.push(`Phone: ${get('phone')}`);
      if (get('message')) lines.push('', get('message'));
      if (viaWhatsapp) {
        window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
        return;
      }

      // Send enquiry: Web3Forms emails it to the reservations inbox
      const label = button?.textContent ?? '';
      const email = get('email');
      if (button) { button.disabled = true; button.textContent = 'Sending…'; }
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: form.dataset.key,
            subject: `Booking enquiry: ${get('name')}, ${pretty(get('checkin'))} to ${pretty(get('checkout'))}`,
            from_name: 'Yangkhil Resort website',
            name: get('name'),
            email,
            phone: get('phone') || 'Not given',
            'Check-in': pretty(get('checkin')),
            'Check-out': pretty(get('checkout')),
            Guests: get('guests'),
            Rooms: get('rooms') || '1',
            'Room type': get('room') || 'No preference',
            message: get('message') || 'No message',
            botcheck: field<HTMLInputElement>('botcheck').checked,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error(data.message || `HTTP ${res.status}`);
        form.reset();
        update();
        success.textContent = `Thank you, your enquiry has been sent to ${form.dataset.email}. Our reservations team will reply soon.`;
        success.hidden = false;
      } catch (err) {
        console.error('[booking] enquiry not sent:', err);
        error.textContent = 'Sorry, your enquiry could not be sent. Please try again, or send it on WhatsApp or call us.';
        error.hidden = false;
      } finally {
        if (button) { button.disabled = false; button.textContent = label; }
      }
    });
  }
</script>
